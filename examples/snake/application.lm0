    branch %ok, ^snapshot(%session, 200), ^error(%s)
^snapshot(%session:ptr<Session>, %code:i32):
    %tp = field %session, touched
    store %tp, %now
    call @snapshot(%session, %buf)
    return %code
^error(%code:i32):
