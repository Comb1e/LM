    %ok = eq %s, 0
    branch %ok, ^request(%buf), ^cleanup(%buf, 503)
^request(%buf:ptr<StdBuf>):
    call @snake_app_expire(%raw, %now)
    %store:ptr<Store> = cast %raw
    %code = call @request(%store, %id, %len, %payload, %now, %buf)
    %ok = lt %code, 400
    branch %ok, ^done(%buf, %code), ^cleanup(%buf, %code)
^done(%buf:ptr<StdBuf>, %code:i32):
    store %out, %buf
    return %code
^cleanup(%buf:ptr<StdBuf>, %code:i32):
    call @std_bytes_destroy(%buf)
    return %code
^failed:
    return 503
}
