}
export c fn @snake_app_request(%raw:ptr<void>, %id:ptr<u8>, %len:u64, %payload:ptr<StdJson>, %now:u64, %out:ptr<ptr<StdBuf>>) -> i32 {
^entry:
    %slot = stack ptr<StdBuf>, 1
    %s = call @std_bytes_new(%slot)
