module math version 2
use std_core
export c fn @std_math_add_i64(%a:i64, %b:i64, %out:ptr<i64>) -> i32 {
^entry:
    %r = add %a, %b
    %x = xor %a, %r
    %y = xor %b, %r
    %bits = and %x, %y
    %overflow = lt %bits, 0
    branch %overflow, ^range(), ^done(%r)
^done(%r:i64):
    store %out, %r
    return 0
^range:
    return 2
}
