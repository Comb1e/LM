^scalar(%buf:ptr<StdBuf>, %code:ptr<u32>, %low:ptr<u32>, %next:u64):
    %v = load %code
    %delta = sub %v, 55296
    %high = lt %delta, 1024
    branch %high, ^pair_length(%buf, %code, %low, %next, %v), ^not_low(%buf, %code, %low, %next, %v)
^not_low(%buf:ptr<StdBuf>, %code:ptr<u32>, %low:ptr<u32>, %next:u64, %v:u32):
    %delta = sub %v, 56320
    %bad = lt %delta, 1024
    branch %bad, ^cleanup(%buf, 5), ^encode(%buf, %code, %low, %next, %v)
^pair_length(%buf:ptr<StdBuf>, %code:ptr<u32>, %low:ptr<u32>, %i:u64, %high:u32):
    %remaining = sub %len, %i
    %fits = ge %remaining, 6
    branch %fits, ^pair_slash(%buf, %code, %low, %i, %high), ^cleanup(%buf, 5)
^pair_slash(%buf:ptr<StdBuf>, %code:ptr<u32>, %low:ptr<u32>, %i:u64, %high:u32):
    %idx:i64 = cast %i
    %p = offset %data, %idx
    %b = load %p
    %slash = eq %b, 92
    branch %slash, ^pair_u(%buf, %code, %low, %i, %high, %p), ^cleanup(%buf, 5)
^pair_u(%buf:ptr<StdBuf>, %code:ptr<u32>, %low:ptr<u32>, %i:u64, %high:u32, %p:ptr<u8>):
    %q = offset %p, 1
    %b = load %q
    %u = eq %b, 117
    branch %u, ^pair_hex(%buf, %code, %low, %i, %high), ^cleanup(%buf, 5)
^pair_hex(%buf:ptr<StdBuf>, %code:ptr<u32>, %low:ptr<u32>, %i:u64, %high:u32):
