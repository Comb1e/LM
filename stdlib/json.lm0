module json version 2
use std_text

struct JsonParser {
    data:ptr<u8>
    len:u64
    index:u64
    doc:ptr<StdJson>
    current:ptr<StdJsonNode>
    key:ptr<StdBuf>
    depth:u64
    limit:u64
    state:i32
}

export c fn @std_json_new(%out:ptr<ptr<StdJson>>) -> i32 {
^entry:
    %raw:ptr<ptr<void>> = cast %out
    %size = sizeof StdJson
    %status = call @std_core_allocate(1, %size, %raw)
    return %status
}
export c fn @std_json_destroy(%doc:ptr<StdJson>) -> void {
^entry:
    %null = eq %doc, null
    branch %null, ^done(), ^start()
^start:
    %hp = field %doc, head
    %head = load %hp
    jump ^loop(%head)
^loop(%node:ptr<StdJsonNode>):
    %end = eq %node, null
    branch %end, ^release(), ^node(%node)
^node(%node:ptr<StdJsonNode>):
    %np = field %node, allocated
    %next = load %np
    %tp = field %node, text
    %kp = field %node, key
    %text = load %tp
    %key = load %kp
    call @std_bytes_destroy(%text)
    call @std_bytes_destroy(%key)
    %raw:ptr<void> = cast %node
    call @std_core_release(%raw)
    jump ^loop(%next)
^release:
    %raw:ptr<void> = cast %doc
    call @std_core_release(%raw)
    return
^done:
    return
}
export c fn @std_json_root(%doc:ptr<StdJson>) -> ptr<StdJsonNode> {
^entry:
    %p = field %doc, root
    %node = load %p
    return %node
}
export c fn @std_json_kind(%node:ptr<StdJsonNode>) -> i32 {
^entry:
    %p = field %node, kind
    %kind = load %p
    return %kind
}
export c fn @std_json_text(%node:ptr<StdJsonNode>, %data:ptr<ptr<u8>>, %len:ptr<u64>) -> i32 {
^entry:
    %kind = call @std_json_kind(%node)
    %d = sub %kind, 3
    %valid = le %d, 1
    %lower = ge %d, 0
    branch %valid, ^lower(%lower), ^invalid()
^lower(%valid:bool):
    branch %valid, ^view(), ^invalid()
^view:
    %tp = field %node, text
    %text = load %tp
    call @std_bytes_view(%text, %data, %len)
    return 0
^invalid:
    return 1
}
export c fn @std_json_i64(%node:ptr<StdJsonNode>, %out:ptr<i64>) -> i32 {
^entry:
    %kind = call @std_json_kind(%node)
    %valid = eq %kind, 3
    branch %valid, ^parse(), ^invalid()
^parse:
    %tp = field %node, text
    %text = load %tp
    %dp = field %text, data
    %lp = field %text, len
    %data = load %dp
    %len = load %lp
    %status = call @std_text_parse_i64(%data, %len, %out)
    return %status
^invalid:
    return 1
}
export c fn @std_json_get(%node:ptr<StdJsonNode>, %key:ptr<u8>, %len:u64, %out:ptr<ptr<StdJsonNode>>) -> i32 {
^entry:
    %kind = call @std_json_kind(%node)
    %valid = eq %kind, 6
    branch %valid, ^start(), ^invalid()
^start:
    %cp = field %node, child
    %child = load %cp
    jump ^loop(%child)
^loop(%child:ptr<StdJsonNode>):
    %end = eq %child, null
    branch %end, ^missing(), ^compare(%child)
^compare(%child:ptr<StdJsonNode>):
    %kp = field %child, key
    %buf = load %kp
    %dp = field %buf, data
    %lp = field %buf, len
    %data = load %dp
    %n = load %lp
    %cmp = call @std_bytes_compare(%key, %len, %data, %n)
    %same = eq %cmp, 0
    branch %same, ^found(%child), ^next(%child)
^next(%child:ptr<StdJsonNode>):
    %np = field %child, next
    %next = load %np
    jump ^loop(%next)
^found(%child:ptr<StdJsonNode>):
    store %out, %child
    return 0
^invalid:
    return 1
^missing:
    return 4
}
export c fn @std_json_at(%node:ptr<StdJsonNode>, %index:u64, %out:ptr<ptr<StdJsonNode>>) -> i32 {
^entry:
    %kind = call @std_json_kind(%node)
    %valid = eq %kind, 5
    branch %valid, ^start(), ^invalid()
^start:
    %cp = field %node, child
    %child = load %cp
    jump ^loop(%child, 0)
^loop(%child:ptr<StdJsonNode>, %i:u64):
    %end = eq %child, null
    branch %end, ^range(), ^compare(%child, %i)
^compare(%child:ptr<StdJsonNode>, %i:u64):
    %same = eq %i, %index
    branch %same, ^found(%child), ^next(%child, %i)
^next(%child:ptr<StdJsonNode>, %i:u64):
    %np = field %child, next
    %next = load %np
    %j = add %i, 1
    jump ^loop(%next, %j)
^found(%child:ptr<StdJsonNode>):
    store %out, %child
    return 0
^invalid:
    return 1
^range:
    return 2
}

# Decimal number DFA: start, integer-required, zero, integer, fraction-required,
# fraction, exponent-sign, exponent-required, exponent. It stops at a delimiter.
fn @number_end(%data:ptr<u8>, %len:u64, %start:u64, %out:ptr<u64>) -> i32 {
^entry:
    jump ^loop(%start, 0)
^loop(%i:u64, %state:i32):
    %end = ge %i, %len
    branch %end, ^finish(%i, %state), ^read(%i, %state)
^read(%i:u64, %state:i32):
    %idx:i64 = cast %i
    %p = offset %data, %idx
    %b = load %p
    %d = sub %b, 48
    %digit = lt %d, 10
    %initial = eq %state, 0
    branch %initial, ^sign(%i, %b, %digit), ^dispatch1(%i, %state, %b, %digit)
^sign(%i:u64, %b:u8, %digit:bool):
    %minus = eq %b, 45
    branch %minus, ^advance(%i, 1), ^integer(%i, %b, %digit)
^dispatch1(%i:u64, %state:i32, %b:u8, %digit:bool):
    %required = eq %state, 1
    branch %required, ^integer(%i, %b, %digit), ^dispatch2(%i, %state, %b, %digit)
^integer(%i:u64, %b:u8, %digit:bool):
    branch %digit, ^first_digit(%i, %b), ^invalid()
^first_digit(%i:u64, %b:u8):
    %zero = eq %b, 48
    branch %zero, ^advance(%i, 2), ^advance(%i, 3)
^dispatch2(%i:u64, %state:i32, %b:u8, %digit:bool):
    %zero = eq %state, 2
    branch %zero, ^fraction_start(%i, %state, %b), ^dispatch3(%i, %state, %b, %digit)
^dispatch3(%i:u64, %state:i32, %b:u8, %digit:bool):
    %integer = eq %state, 3
    branch %integer, ^integer_tail(%i, %state, %b, %digit), ^dispatch4(%i, %state, %b, %digit)
^integer_tail(%i:u64, %state:i32, %b:u8, %digit:bool):
    branch %digit, ^advance(%i, 3), ^fraction_start(%i, %state, %b)
^fraction_start(%i:u64, %state:i32, %b:u8):
    %dot = eq %b, 46
    branch %dot, ^advance(%i, 4), ^exponent_start(%i, %state, %b)
^dispatch4(%i:u64, %state:i32, %b:u8, %digit:bool):
    %required = eq %state, 4
    branch %required, ^fraction_required(%i, %digit), ^dispatch5(%i, %state, %b, %digit)
^fraction_required(%i:u64, %digit:bool):
    branch %digit, ^advance(%i, 5), ^invalid()
^dispatch5(%i:u64, %state:i32, %b:u8, %digit:bool):
    %fraction = eq %state, 5
    branch %fraction, ^fraction_tail(%i, %state, %b, %digit), ^dispatch6(%i, %state, %b, %digit)
^fraction_tail(%i:u64, %state:i32, %b:u8, %digit:bool):
    branch %digit, ^advance(%i, 5), ^exponent_start(%i, %state, %b)
^exponent_start(%i:u64, %state:i32, %b:u8):
    %lower = or %b, 32
    %e = eq %lower, 101
    branch %e, ^advance(%i, 6), ^finish(%i, %state)
^dispatch6(%i:u64, %state:i32, %b:u8, %digit:bool):
    %sign = eq %state, 6
    branch %sign, ^exponent_sign(%i, %b, %digit), ^dispatch7(%i, %state, %digit)
^exponent_sign(%i:u64, %b:u8, %digit:bool):
    %plus = eq %b, 43
    branch %plus, ^advance(%i, 7), ^exponent_minus(%i, %b, %digit)
^exponent_minus(%i:u64, %b:u8, %digit:bool):
    %minus = eq %b, 45
    branch %minus, ^advance(%i, 7), ^exponent_required(%i, %digit)
^dispatch7(%i:u64, %state:i32, %digit:bool):
    %required = eq %state, 7
    branch %required, ^exponent_required(%i, %digit), ^exponent_tail(%i, %state, %digit)
^exponent_required(%i:u64, %digit:bool):
    branch %digit, ^advance(%i, 8), ^invalid()
^exponent_tail(%i:u64, %state:i32, %digit:bool):
    branch %digit, ^advance(%i, 8), ^finish(%i, %state)
^advance(%i:u64, %state:i32):
    %next = add %i, 1
    jump ^loop(%next, %state)
^finish(%i:u64, %state:i32):
    %zero = eq %state, 2
    branch %zero, ^done(%i), ^finish3(%i, %state)
^finish3(%i:u64, %state:i32):
    %integer = eq %state, 3
    branch %integer, ^done(%i), ^finish5(%i, %state)
^finish5(%i:u64, %state:i32):
    %fraction = eq %state, 5
    branch %fraction, ^done(%i), ^finish8(%i, %state)
^finish8(%i:u64, %state:i32):
    %exponent = eq %state, 8
    branch %exponent, ^done(%i), ^invalid()
^done(%i:u64):
    store %out, %i
    return 0
^invalid:
    return 6
}

export c fn @std_json_create(%doc:ptr<StdJson>, %kind:i32, %data:ptr<u8>, %len:u64, %out:ptr<ptr<StdJsonNode>>) -> i32 {
^entry:
    %end = stack u64, 1
    %slot = stack ptr<void>, 1
    %ts = stack ptr<StdBuf>, 1
    store %ts, null
    %uk:u32 = cast %kind
    %valid = le %uk, 6
    branch %valid, ^classify(%end, %slot, %ts), ^invalid()
^classify(%end:ptr<u64>, %slot:ptr<ptr<void>>, %ts:ptr<ptr<StdBuf>>):
    %string = eq %kind, 4
    branch %string, ^string(%slot, %ts), ^number_check(%end, %slot, %ts)
^string(%slot:ptr<ptr<void>>, %ts:ptr<ptr<StdBuf>>):
    %status = call @std_text_validate(%data, %len)
    %ok = eq %status, 0
    branch %ok, ^text(%slot, %ts), ^error(%status)
^number_check(%end:ptr<u64>, %slot:ptr<ptr<void>>, %ts:ptr<ptr<StdBuf>>):
    %number = eq %kind, 3
    branch %number, ^number(%end, %slot, %ts), ^empty(%slot, %ts)
^number(%end:ptr<u64>, %slot:ptr<ptr<void>>, %ts:ptr<ptr<StdBuf>>):
    %status = call @number_end(%data, %len, 0, %end)
    %ok = eq %status, 0
    branch %ok, ^number_complete(%end, %slot, %ts), ^error(%status)
^number_complete(%end:ptr<u64>, %slot:ptr<ptr<void>>, %ts:ptr<ptr<StdBuf>>):
    %n = load %end
    %complete = eq %n, %len
    branch %complete, ^text(%slot, %ts), ^parse_error()
^empty(%slot:ptr<ptr<void>>, %ts:ptr<ptr<StdBuf>>):
    %empty = eq %len, 0
    branch %empty, ^budget(%slot, %ts), ^invalid()
^text(%slot:ptr<ptr<void>>, %ts:ptr<ptr<StdBuf>>):
    %status = call @std_bytes_new(%ts)
    %ok = eq %status, 0
    branch %ok, ^copy(%slot, %ts), ^error(%status)
^copy(%slot:ptr<ptr<void>>, %ts:ptr<ptr<StdBuf>>):
    %buf = load %ts
    %status = call @std_bytes_append(%buf, %data, %len)
    %ok = eq %status, 0
    branch %ok, ^budget(%slot, %ts), ^cleanup(%ts, %status)
^budget(%slot:ptr<ptr<void>>, %ts:ptr<ptr<StdBuf>>):
    %cp = field %doc, count
    %count = load %cp
    %limit = call @std_core_json_nodes()
    %fits = lt %count, %limit
    branch %fits, ^allocate(%slot, %ts), ^cleanup(%ts, 9)
^allocate(%slot:ptr<ptr<void>>, %ts:ptr<ptr<StdBuf>>):
    %size = sizeof StdJsonNode
    %status = call @std_core_allocate(1, %size, %slot)
    %ok = eq %status, 0
    branch %ok, ^commit(%slot, %ts), ^cleanup(%ts, %status)
^commit(%slot:ptr<ptr<void>>, %ts:ptr<ptr<StdBuf>>):
    %raw = load %slot
    %node:ptr<StdJsonNode> = cast %raw
    %text = load %ts
    %kp = field %node, kind
    %tp = field %node, text
    %op = field %node, owner
    %ap = field %node, allocated
    %hp = field %doc, head
    %cp = field %doc, count
    %head = load %hp
    %count = load %cp
    %next = add %count, 1
    store %kp, %kind
    store %tp, %text
    store %op, %doc
    store %ap, %head
    store %hp, %node
    store %cp, %next
    store %out, %node
    return 0
^cleanup(%ts:ptr<ptr<StdBuf>>, %status:i32):
    %text = load %ts
    call @std_bytes_destroy(%text)
    return %status
^invalid:
    return 1
^parse_error:
    return 6
^error(%status:i32):
    return %status
}

export c fn @std_json_set_root(%doc:ptr<StdJson>, %node:ptr<StdJsonNode>) -> i32 {
^entry:
    %null = eq %node, null
    branch %null, ^invalid(), ^owner()
^owner:
    %op = field %node, owner
    %owner = load %op
    %same = eq %owner, %doc
    branch %same, ^parent(), ^invalid()
^parent:
    %pp = field %node, parent
    %parent = load %pp
    %detached = eq %parent, null
    branch %detached, ^done(), ^invalid()
^done:
    %rp = field %doc, root
    store %rp, %node
    return 0
^invalid:
    return 1
}

fn @attach_check(%parent:ptr<StdJsonNode>, %value:ptr<StdJsonNode>) -> i32 {
^entry:
    %null = eq %value, null
    branch %null, ^invalid(), ^owner()
^owner:
    %po = field %parent, owner
    %vo = field %value, owner
    %a = load %po
    %b = load %vo
    %same = eq %a, %b
    branch %same, ^root(%a), ^invalid()
^root(%doc:ptr<StdJson>):
    %root = call @std_json_root(%doc)
    %isroot = eq %root, %value
    branch %isroot, ^invalid(), ^parent()
^parent:
    %pp = field %value, parent
    %p = load %pp
    %detached = eq %p, null
    branch %detached, ^ancestors(%parent), ^invalid()
^ancestors(%p:ptr<StdJsonNode>):
    %end = eq %p, null
    branch %end, ^done(), ^cycle(%p)
^cycle(%p:ptr<StdJsonNode>):
    %same = eq %p, %value
    branch %same, ^invalid(), ^next(%p)
^next(%p:ptr<StdJsonNode>):
    %pp = field %p, parent
    %next = load %pp
    jump ^ancestors(%next)
^done:
    return 0
^invalid:
    return 1
}
fn @link_child(%parent:ptr<StdJsonNode>, %value:ptr<StdJsonNode>) -> void {
^entry:
    %tp = field %parent, tail
    %tail = load %tp
    %empty = eq %tail, null
    branch %empty, ^first(), ^after(%tail)
^first:
    %cp = field %parent, child
    store %cp, %value
    jump ^done()
^after(%tail:ptr<StdJsonNode>):
    %np = field %tail, next
    store %np, %value
    jump ^done()
^done:
    %tp = field %parent, tail
    %pp = field %value, parent
    %np = field %value, next
    store %tp, %value
    store %pp, %parent
    store %np, null
    return
}
export c fn @std_json_append(%array:ptr<StdJsonNode>, %value:ptr<StdJsonNode>) -> i32 {
^entry:
    %kind = call @std_json_kind(%array)
    %valid = eq %kind, 5
    branch %valid, ^check(), ^invalid()
^check:
    %status = call @attach_check(%array, %value)
    %ok = eq %status, 0
    branch %ok, ^done(), ^error(%status)
^done:
    call @link_child(%array, %value)
    return 0
^invalid:
    return 1
^error(%status:i32):
    return %status
}
export c fn @std_json_set(%object:ptr<StdJsonNode>, %key:ptr<u8>, %len:u64, %value:ptr<StdJsonNode>) -> i32 {
^entry:
    %ks = stack ptr<StdBuf>, 1
    %oldslot = stack ptr<StdJsonNode>, 1
    %kind = call @std_json_kind(%object)
    %valid = eq %kind, 6
    branch %valid, ^check(%ks, %oldslot), ^invalid()
^check(%ks:ptr<ptr<StdBuf>>, %oldslot:ptr<ptr<StdJsonNode>>):
    %status = call @attach_check(%object, %value)
    %ok = eq %status, 0
    branch %ok, ^encoding(%ks, %oldslot), ^error(%status)
^encoding(%ks:ptr<ptr<StdBuf>>, %oldslot:ptr<ptr<StdJsonNode>>):
    %status = call @std_text_validate(%key, %len)
    %ok = eq %status, 0
    branch %ok, ^buffer(%ks, %oldslot), ^error(%status)
^buffer(%ks:ptr<ptr<StdBuf>>, %oldslot:ptr<ptr<StdJsonNode>>):
    %status = call @std_bytes_new(%ks)
    %ok = eq %status, 0
    branch %ok, ^copy(%ks, %oldslot), ^error(%status)
^copy(%ks:ptr<ptr<StdBuf>>, %oldslot:ptr<ptr<StdJsonNode>>):
    %buf = load %ks
    %status = call @std_bytes_append(%buf, %key, %len)
    %ok = eq %status, 0
    branch %ok, ^lookup(%buf, %oldslot), ^cleanup(%buf, %status)
^lookup(%buf:ptr<StdBuf>, %oldslot:ptr<ptr<StdJsonNode>>):
    %status = call @std_json_get(%object, %key, %len, %oldslot)
    %kp = field %value, key
    %oldkey = load %kp
    call @std_bytes_destroy(%oldkey)
    store %kp, %buf
    %found = eq %status, 0
    branch %found, ^replace(%oldslot), ^append()
^append:
    call @link_child(%object, %value)
    return 0
^replace(%oldslot:ptr<ptr<StdJsonNode>>):
    %old = load %oldslot
    %cp = field %object, child
    jump ^find_link(%old, %cp)
^find_link(%old:ptr<StdJsonNode>, %link:ptr<ptr<StdJsonNode>>):
    %current = load %link
    %same = eq %current, %old
    branch %same, ^replace_link(%old, %link), ^next_link(%old, %current)
^next_link(%old:ptr<StdJsonNode>, %current:ptr<StdJsonNode>):
    %next = field %current, next
    jump ^find_link(%old, %next)
^replace_link(%old:ptr<StdJsonNode>, %link:ptr<ptr<StdJsonNode>>):
    %np = field %old, next
    %next = load %np
    %vp = field %value, next
    %pp = field %value, parent
    %op = field %old, parent
    store %vp, %next
    store %pp, %object
    store %link, %value
    store %np, null
    store %op, null
    %tp = field %object, tail
    %tail = load %tp
    %last = eq %tail, %old
    branch %last, ^tail(%tp), ^done()
^tail(%tp:ptr<ptr<StdJsonNode>>):
    store %tp, %value
    return 0
^done:
    return 0
^cleanup(%buf:ptr<StdBuf>, %status:i32):
    call @std_bytes_destroy(%buf)
    return %status
^invalid:
    return 1
^error(%status:i32):
    return %status
}

fn @hex4(%data:ptr<u8>, %len:u64, %start:u64, %out:ptr<u32>) -> i32 {
^entry:
    %fits = le %start, %len
    branch %fits, ^length(), ^invalid()
^length:
    %room = sub %len, %start
    %fits = ge %room, 4
    branch %fits, ^loop(0, 0), ^invalid()
^loop(%i:u64, %v:u32):
    %end = eq %i, 4
    branch %end, ^done(%v), ^read(%i, %v)
^read(%i:u64, %v:u32):
    %at = add %start, %i
    %idx:i64 = cast %at
    %p = offset %data, %idx
    %b = load %p
    %d = sub %b, 48
    %digit = lt %d, 10
    branch %digit, ^step(%i, %v, %d), ^letter(%i, %v, %b)
^letter(%i:u64, %v:u32, %b:u8):
    %lower = or %b, 32
    %d = sub %lower, 97
    %valid = lt %d, 6
    %value = add %d, 10
    branch %valid, ^step(%i, %v, %value), ^invalid()
^step(%i:u64, %v:u32, %d:u8):
    %wide:u32 = cast %d
    %shift = shl %v, 4
    %next = or %shift, %wide
    %j = add %i, 1
    jump ^loop(%j, %next)
^done(%v:u32):
    store %out, %v
    return 0
^invalid:
    return 6
}

fn @encode_scalar(%buf:ptr<StdBuf>, %scalar:u32) -> i32 {
^entry:
    %temp = stack u8, 4
    %ascii = lt %scalar, 128
    branch %ascii, ^one(%temp), ^two_check(%temp)
^one(%temp:ptr<u8>):
    %b:u8 = cast %scalar
    store %temp, %b
    jump ^append(%temp, 1)
^two_check(%temp:ptr<u8>):
    %two = lt %scalar, 2048
    branch %two, ^head(%temp, 2, 6, 192), ^three_check(%temp)
^three_check(%temp:ptr<u8>):
    %three = lt %scalar, 65536
    branch %three, ^head(%temp, 3, 12, 224), ^head(%temp, 4, 18, 240)
^head(%temp:ptr<u8>, %n:u64, %shift:u32, %prefix:u32):
    %bits = shr %scalar, %shift
    %head = or %bits, %prefix
    %b:u8 = cast %head
    store %temp, %b
    jump ^tail(%temp, %n, 1, %shift)
^tail(%temp:ptr<u8>, %n:u64, %i:u64, %shift:u32):
    %done = eq %i, %n
    branch %done, ^append(%temp, %n), ^byte(%temp, %n, %i, %shift)
^byte(%temp:ptr<u8>, %n:u64, %i:u64, %shift:u32):
    %nextshift = sub %shift, 6
    %bits = shr %scalar, %nextshift
    %low = and %bits, 63
    %value = or %low, 128
    %b:u8 = cast %value
    %idx:i64 = cast %i
    %p = offset %temp, %idx
    store %p, %b
    %j = add %i, 1
    jump ^tail(%temp, %n, %j, %nextshift)
^append(%temp:ptr<u8>, %n:u64):
    %status = call @std_bytes_append(%buf, %temp, %n)
    return %status
}

fn @decode_string(%data:ptr<u8>, %len:u64, %index:ptr<u64>, %out:ptr<ptr<StdBuf>>) -> i32 {
^entry:
    %slot = stack ptr<StdBuf>, 1
    %code = stack u32, 1
    %low = stack u32, 1
    %status = call @std_bytes_new(%slot)
    %ok = eq %status, 0
    branch %ok, ^start(%slot, %code, %low), ^error(%status)
^start(%slot:ptr<ptr<StdBuf>>, %code:ptr<u32>, %low:ptr<u32>):
    %buf = load %slot
    %at = load %index
    %i = add %at, 1
    jump ^loop(%buf, %code, %low, %i)
^loop(%buf:ptr<StdBuf>, %code:ptr<u32>, %low:ptr<u32>, %i:u64):
    %end = ge %i, %len
    branch %end, ^cleanup(%buf, 6), ^read(%buf, %code, %low, %i)
^read(%buf:ptr<StdBuf>, %code:ptr<u32>, %low:ptr<u32>, %i:u64):
    %idx:i64 = cast %i
    %p = offset %data, %idx
    %b = load %p
    %quote = eq %b, 34
    %next = add %i, 1
    branch %quote, ^done(%buf, %next), ^control(%buf, %code, %low, %next, %b)
^control(%buf:ptr<StdBuf>, %code:ptr<u32>, %low:ptr<u32>, %next:u64, %b:u8):
    %invalid = lt %b, 32
