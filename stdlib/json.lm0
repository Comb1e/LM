^escaped(%buf:ptr<StdBuf>, %code:ptr<u32>, %low:ptr<u32>, %i:u64):
    %idx:i64 = cast %i
    %p = offset %data, %idx
    %b = load %p
    %next = add %i, 1
    %unicode = eq %b, 117
