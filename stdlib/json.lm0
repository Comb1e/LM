^pair_value(%buf:ptr<StdBuf>, %code:ptr<u32>, %low:ptr<u32>, %i:u64, %high:u32):
    %v = load %low
    %delta = sub %v, 56320
    %valid = lt %delta, 1024
    %upper = sub %high, 55296
    %shift = shl %upper, 10
    %bits = or %shift, %delta
    %scalar = add %bits, 65536
