    %ok = eq %status, 0
    branch %ok, ^loop(%buf, %code, %low, %next), ^cleanup(%buf, %status)
^push(%buf:ptr<StdBuf>, %code:ptr<u32>, %low:ptr<u32>, %next:u64, %b:u8):
    %status = call @std_bytes_push(%buf, %b)
    %ok = eq %status, 0
