^done(%buf:ptr<StdBuf>, %next:u64):
    store %out, %buf
    store %index, %next
    return 0
^cleanup(%buf:ptr<StdBuf>, %status:i32):
    call @std_bytes_destroy(%buf)
    return %status
^error(%status:i32):
    return %status
}

fn @peek(%parser:ptr<JsonParser>) -> i32 {
^entry:
    %ip = field %parser, index
    %lp = field %parser, len
    %i = load %ip
    %n = load %lp
    %end = ge %i, %n
    branch %end, ^eof(), ^read(%i)
^read(%i:u64):
    %dp = field %parser, data
    %data = load %dp
    %idx:i64 = cast %i
    %p = offset %data, %idx
    %b = load %p
    %wide:i32 = cast %b
    return %wide
^eof:
    return -1
}
fn @bump(%parser:ptr<JsonParser>) -> void {
^entry:
    %ip = field %parser, index
    %i = load %ip
    %next = add %i, 1
    store %ip, %next
    return
}
fn @parser_state(%parser:ptr<JsonParser>, %state:i32) -> void {
^entry:
    %sp = field %parser, state
    store %sp, %state
    return
}

# Attach one parsed value, then transition to the new container or its parent's
# separator state. Object keys are consumed only after a successful attachment.
fn @parsed_node(%parser:ptr<JsonParser>, %node:ptr<StdJsonNode>) -> i32 {
^entry:
    %existing = stack ptr<StdJsonNode>, 1
    %cp = field %parser, current
    %parent = load %cp
    %root = eq %parent, null
    branch %root, ^root(), ^container(%existing, %parent)
^root:
    %dp = field %parser, doc
    %doc = load %dp
    %status = call @std_json_set_root(%doc, %node)
    jump ^status(%status)
^container(%existing:ptr<ptr<StdJsonNode>>, %parent:ptr<StdJsonNode>):
    %kind = call @std_json_kind(%parent)
    %array = eq %kind, 5
    branch %array, ^array(%parent), ^object(%existing, %parent)
^array(%parent:ptr<StdJsonNode>):
    %status = call @std_json_append(%parent, %node)
    jump ^status(%status)
^object(%existing:ptr<ptr<StdJsonNode>>, %parent:ptr<StdJsonNode>):
    %kp = field %parser, key
    %key = load %kp
    %dp = field %key, data
    %lp = field %key, len
    %data = load %dp
    %len = load %lp
    %found = call @std_json_get(%parent, %data, %len, %existing)
    %duplicate = eq %found, 0
    branch %duplicate, ^error(6), ^set(%parent, %key, %data, %len)
^set(%parent:ptr<StdJsonNode>, %key:ptr<StdBuf>, %data:ptr<u8>, %len:u64):
    %status = call @std_json_set(%parent, %data, %len, %node)
    call @std_bytes_destroy(%key)
    %kp = field %parser, key
    store %kp, null
    jump ^status(%status)
^status(%status:i32):
    %ok = eq %status, 0
    branch %ok, ^kind(), ^error(%status)
^kind:
    %kind = call @std_json_kind(%node)
    %container = ge %kind, 5
    branch %container, ^depth(%kind), ^primitive()
^depth(%kind:i32):
    %dp = field %parser, depth
    %lp = field %parser, limit
    %depth = load %dp
    %limit = load %lp
    %fits = lt %depth, %limit
    branch %fits, ^enter(%kind, %depth), ^error(9)
^enter(%kind:i32, %depth:u64):
    %next = add %depth, 1
    %dp = field %parser, depth
    %cp = field %parser, current
    store %dp, %next
    store %cp, %node
    %array = eq %kind, 5
    branch %array, ^state(1), ^state(3)
^primitive:
    %cp = field %parser, current
    %parent = load %cp
    %root = eq %parent, null
    branch %root, ^state(9), ^state(2)
^state(%state:i32):
    call @parser_state(%parser, %state)
    return 0
^error(%status:i32):
    return %status
}

data @json_null = "null"
data @json_false = "false"
data @json_true = "true"

fn @parse_value(%parser:ptr<JsonParser>) -> i32 {
^entry:
    %slot = stack ptr<StdJsonNode>, 1
    %bufslot = stack ptr<StdBuf>, 1
    %end = stack u64, 1
    %dp = field %parser, doc
    %doc = load %dp
    %b = call @peek(%parser)
    %array = eq %b, 91
    branch %array, ^container(%slot, %doc, 5), ^object(%slot, %bufslot, %end, %doc, %b)
^object(%slot:ptr<ptr<StdJsonNode>>, %bufslot:ptr<ptr<StdBuf>>, %end:ptr<u64>, %doc:ptr<StdJson>, %b:i32):
    %object = eq %b, 123
    branch %object, ^container(%slot, %doc, 6), ^string_check(%slot, %bufslot, %end, %doc, %b)
^container(%slot:ptr<ptr<StdJsonNode>>, %doc:ptr<StdJson>, %kind:i32):
    %status = call @std_json_create(%doc, %kind, null, 0, %slot)
    call @bump(%parser)
    jump ^status(%slot, %status)
^string_check(%slot:ptr<ptr<StdJsonNode>>, %bufslot:ptr<ptr<StdBuf>>, %end:ptr<u64>, %doc:ptr<StdJson>, %b:i32):
    %dp = field %parser, data
    %lp = field %parser, len
    %ip = field %parser, index
    %data = load %dp
    %len = load %lp
    %quote = eq %b, 34
    branch %quote, ^string(%slot, %bufslot, %doc, %data, %len, %ip), ^null_check(%slot, %end, %doc, %data, %len, %ip, %b)
^string(%slot:ptr<ptr<StdJsonNode>>, %bufslot:ptr<ptr<StdBuf>>, %doc:ptr<StdJson>, %data:ptr<u8>, %len:u64, %ip:ptr<u64>):
    %status = call @decode_string(%data, %len, %ip, %bufslot)
    %ok = eq %status, 0
    branch %ok, ^string_node(%slot, %bufslot, %doc), ^error(%status)
^string_node(%slot:ptr<ptr<StdJsonNode>>, %bufslot:ptr<ptr<StdBuf>>, %doc:ptr<StdJson>):
    %buf = load %bufslot
    %dp = field %buf, data
    %lp = field %buf, len
    %data = load %dp
    %len = load %lp
    %status = call @std_json_create(%doc, 4, %data, %len, %slot)
    call @std_bytes_destroy(%buf)
    jump ^status(%slot, %status)
^null_check(%slot:ptr<ptr<StdJsonNode>>, %end:ptr<u64>, %doc:ptr<StdJson>, %data:ptr<u8>, %len:u64, %ip:ptr<u64>, %b:i32):
    %null = eq %b, 110
    %word = address @json_null
    branch %null, ^literal(%slot, %doc, %data, %len, %ip, %word, 4, 0), ^false_check(%slot, %end, %doc, %data, %len, %ip, %b)
^false_check(%slot:ptr<ptr<StdJsonNode>>, %end:ptr<u64>, %doc:ptr<StdJson>, %data:ptr<u8>, %len:u64, %ip:ptr<u64>, %b:i32):
    %false = eq %b, 102
    %word = address @json_false
    branch %false, ^literal(%slot, %doc, %data, %len, %ip, %word, 5, 1), ^true_check(%slot, %end, %doc, %data, %len, %ip, %b)
^true_check(%slot:ptr<ptr<StdJsonNode>>, %end:ptr<u64>, %doc:ptr<StdJson>, %data:ptr<u8>, %len:u64, %ip:ptr<u64>, %b:i32):
    %true = eq %b, 116
    %word = address @json_true
    branch %true, ^literal(%slot, %doc, %data, %len, %ip, %word, 4, 2), ^number(%slot, %end, %doc, %data, %len, %ip)
^literal(%slot:ptr<ptr<StdJsonNode>>, %doc:ptr<StdJson>, %data:ptr<u8>, %len:u64, %ip:ptr<u64>, %word:ptr<u8>, %size:u64, %kind:i32):
    %i = load %ip
    %room = sub %len, %i
    %fits = ge %room, %size
    branch %fits, ^word(%slot, %doc, %data, %ip, %word, %size, %kind, %i), ^error(6)
^word(%slot:ptr<ptr<StdJsonNode>>, %doc:ptr<StdJson>, %data:ptr<u8>, %ip:ptr<u64>, %word:ptr<u8>, %size:u64, %kind:i32, %i:u64):
    %idx:i64 = cast %i
    %p = offset %data, %idx
    %cmp = call @std_bytes_compare(%p, %size, %word, %size)
    %same = eq %cmp, 0
    branch %same, ^literal_node(%slot, %doc, %ip, %size, %kind, %i), ^error(6)
^literal_node(%slot:ptr<ptr<StdJsonNode>>, %doc:ptr<StdJson>, %ip:ptr<u64>, %size:u64, %kind:i32, %i:u64):
    %next = add %i, %size
    store %ip, %next
    %status = call @std_json_create(%doc, %kind, null, 0, %slot)
    jump ^status(%slot, %status)
^number(%slot:ptr<ptr<StdJsonNode>>, %end:ptr<u64>, %doc:ptr<StdJson>, %data:ptr<u8>, %len:u64, %ip:ptr<u64>):
    %i = load %ip
    %status = call @number_end(%data, %len, %i, %end)
    %ok = eq %status, 0
    branch %ok, ^number_node(%slot, %end, %doc, %data, %ip, %i), ^error(%status)
^number_node(%slot:ptr<ptr<StdJsonNode>>, %end:ptr<u64>, %doc:ptr<StdJson>, %data:ptr<u8>, %ip:ptr<u64>, %i:u64):
    %next = load %end
    %size = sub %next, %i
    %idx:i64 = cast %i
    %p = offset %data, %idx
    store %ip, %next
    %status = call @std_json_create(%doc, 3, %p, %size, %slot)
    jump ^status(%slot, %status)
^status(%slot:ptr<ptr<StdJsonNode>>, %status:i32):
    %ok = eq %status, 0
    branch %ok, ^attach(%slot), ^error(%status)
^attach(%slot:ptr<ptr<StdJsonNode>>):
    %node = load %slot
    %status = call @parsed_node(%parser, %node)
    return %status
^error(%status:i32):
    return %status
}

export c fn @std_json_parse(%data:ptr<u8>, %len:u64, %depth:u64, %out:ptr<ptr<StdJson>>) -> i32 {
^entry:
    %parser = stack JsonParser, 1
    %status = call @std_text_validate(%data, %len)
    %ok = eq %status, 0
    branch %ok, ^new(%parser), ^error(%status)
^new(%parser:ptr<JsonParser>):
    %dp = field %parser, doc
    %status = call @std_json_new(%dp)
    %ok = eq %status, 0
    branch %ok, ^limit(%parser), ^error(%status)
^limit(%parser:ptr<JsonParser>):
    %zero = eq %depth, 0
    branch %zero, ^default(%parser), ^initialize(%parser, %depth)
^default(%parser:ptr<JsonParser>):
    %limit = call @std_core_json_depth()
    jump ^initialize(%parser, %limit)
^initialize(%parser:ptr<JsonParser>, %limit:u64):
    %dp = field %parser, data
    %lp = field %parser, len
    %ip = field %parser, index
    %cp = field %parser, current
    %kp = field %parser, key
    %depthp = field %parser, depth
    %limitp = field %parser, limit
    store %dp, %data
    store %lp, %len
    store %ip, 0
    store %cp, null
    store %kp, null
    store %depthp, 0
    store %limitp, %limit
    call @parser_state(%parser, 0)
    jump ^loop(%parser)
^loop(%parser:ptr<JsonParser>):
    %b = call @peek(%parser)
    %space = eq %b, 32
    branch %space, ^space(%parser), ^whitespace(%parser, %b)
^whitespace(%parser:ptr<JsonParser>, %b:i32):
    %tab = eq %b, 9
    branch %tab, ^space(%parser), ^newline(%parser, %b)
^newline(%parser:ptr<JsonParser>, %b:i32):
    %lf = eq %b, 10
    branch %lf, ^space(%parser), ^carriage(%parser, %b)
^carriage(%parser:ptr<JsonParser>, %b:i32):
    %cr = eq %b, 13
    branch %cr, ^space(%parser), ^dispatch(%parser, %b)
^space(%parser:ptr<JsonParser>):
    call @bump(%parser)
    jump ^loop(%parser)
^dispatch(%parser:ptr<JsonParser>, %b:i32):
    %sp = field %parser, state
    %state = load %sp
    %done = eq %state, 9
    branch %done, ^finish(%parser, %b), ^value_check(%parser, %b, %state)
^value_check(%parser:ptr<JsonParser>, %b:i32, %state:i32):
    %value = eq %state, 0
    branch %value, ^value(%parser), ^array_required(%parser, %b, %state)
^array_required(%parser:ptr<JsonParser>, %b:i32, %state:i32):
    %required = eq %state, 8
    branch %required, ^value(%parser), ^array_first(%parser, %b, %state)
^array_first(%parser:ptr<JsonParser>, %b:i32, %state:i32):
    %first = eq %state, 1
    branch %first, ^array_end(%parser, %b), ^object_first(%parser, %b, %state)
^array_end(%parser:ptr<JsonParser>, %b:i32):
    %end = eq %b, 93
    branch %end, ^close(%parser), ^value(%parser)
^object_first(%parser:ptr<JsonParser>, %b:i32, %state:i32):
    %first = eq %state, 3
    branch %first, ^object_end(%parser, %b), ^key_required(%parser, %b, %state)
^object_end(%parser:ptr<JsonParser>, %b:i32):
    %end = eq %b, 125
    branch %end, ^close(%parser), ^key(%parser, %b)
^key_required(%parser:ptr<JsonParser>, %b:i32, %state:i32):
    %required = eq %state, 7
    branch %required, ^key(%parser, %b), ^colon_check(%parser, %b, %state)
^colon_check(%parser:ptr<JsonParser>, %b:i32, %state:i32):
    %colon = eq %state, 4
    branch %colon, ^colon(%parser, %b), ^separator(%parser, %b)
^colon(%parser:ptr<JsonParser>, %b:i32):
    %colon = eq %b, 58
    branch %colon, ^transition(%parser, 0), ^cleanup(%parser, 6)
^separator(%parser:ptr<JsonParser>, %b:i32):
    %cp = field %parser, current
    %parent = load %cp
    %kind = call @std_json_kind(%parent)
    %array = eq %kind, 5
    branch %array, ^array_separator(%parser, %b), ^object_separator(%parser, %b)
^array_separator(%parser:ptr<JsonParser>, %b:i32):
    %end = eq %b, 93
    branch %end, ^close(%parser), ^comma(%parser, %b, 8)
^object_separator(%parser:ptr<JsonParser>, %b:i32):
    %end = eq %b, 125
    branch %end, ^close(%parser), ^comma(%parser, %b, 7)
^comma(%parser:ptr<JsonParser>, %b:i32, %state:i32):
    %comma = eq %b, 44
    branch %comma, ^transition(%parser, %state), ^cleanup(%parser, 6)
^transition(%parser:ptr<JsonParser>, %state:i32):
    call @bump(%parser)
    call @parser_state(%parser, %state)
    jump ^loop(%parser)
^key(%parser:ptr<JsonParser>, %b:i32):
    %quote = eq %b, 34
    branch %quote, ^decode_key(%parser), ^cleanup(%parser, 6)
^decode_key(%parser:ptr<JsonParser>):
    %ip = field %parser, index
    %kp = field %parser, key
    %status = call @decode_string(%data, %len, %ip, %kp)
    %ok = eq %status, 0
    branch %ok, ^key_done(%parser), ^cleanup(%parser, %status)
^key_done(%parser:ptr<JsonParser>):
    call @parser_state(%parser, 4)
    jump ^loop(%parser)
^value(%parser:ptr<JsonParser>):
    %status = call @parse_value(%parser)
    %ok = eq %status, 0
    branch %ok, ^loop(%parser), ^cleanup(%parser, %status)
^close(%parser:ptr<JsonParser>):
    %cp = field %parser, current
    %current = load %cp
    %pp = field %current, parent
    %parent = load %pp
    store %cp, %parent
    %dp = field %parser, depth
    %d = load %dp
    %next = sub %d, 1
    store %dp, %next
    %root = eq %parent, null
    branch %root, ^transition(%parser, 9), ^transition(%parser, 2)
^finish(%parser:ptr<JsonParser>, %b:i32):
    %eof = eq %b, -1
    branch %eof, ^done(%parser), ^cleanup(%parser, 6)
^done(%parser:ptr<JsonParser>):
    %dp = field %parser, doc
    %doc = load %dp
    store %out, %doc
    return 0
^cleanup(%parser:ptr<JsonParser>, %status:i32):
    %kp = field %parser, key
    %dp = field %parser, doc
    %key = load %kp
    %doc = load %dp
    call @std_bytes_destroy(%key)
    call @std_json_destroy(%doc)
    return %status
^error(%status:i32):
    return %status
}

fn @write_bytes(%buf:ptr<StdBuf>, %limit:u64, %data:ptr<u8>, %len:u64) -> i32 {
^entry:
    %lp = field %buf, len
    %used = load %lp
    %room = sub %limit, %used
    %fits = le %len, %room
    branch %fits, ^write(), ^limit()
^write:
    %status = call @std_bytes_append(%buf, %data, %len)
    return %status
^limit:
    return 9
}
fn @write_byte(%buf:ptr<StdBuf>, %limit:u64, %byte:u8) -> i32 {
^entry:
    %slot = stack u8, 1
    store %slot, %byte
    %status = call @write_bytes(%buf, %limit, %slot, 1)
    return %status
}
data @hex_digits = "0123456789abcdef"
fn @write_string(%buf:ptr<StdBuf>, %limit:u64, %text:ptr<StdBuf>) -> i32 {
^entry:
    %escape = stack u8, 6
    %status = call @write_byte(%buf, %limit, 34)
    %ok = eq %status, 0
    branch %ok, ^start(%escape), ^error(%status)
^start(%escape:ptr<u8>):
    %dp = field %text, data
    %lp = field %text, len
    %data = load %dp
