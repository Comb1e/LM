    %d = sub %low, 97
    %hex = le %d, 5
    branch %hex, ^ipv6(%next), ^bad()
^bracket_end(%i:u64):
    %empty = eq %i, 1
    %end = add %i, 1
    branch %empty, ^bad(), ^host_end(%end)
^host(%i:u64):
    %done = eq %i, %len
    branch %done, ^host_end(%i), ^host_byte(%i)
^host_byte(%i:u64):
    %b = call @byte(%data, %i)
    %colon = eq %b, 58
    branch %colon, ^host_end(%i), ^host_char(%i, %b)
^host_char(%i:u64, %b:u8):
    %n = add %i, 1
    %d = sub %b, 48
    %digit = le %d, 9
    branch %digit, ^host(%n), ^host_letter(%n, %b)
^host_letter(%n:u64, %b:u8):
    %low = or %b, 32
    %d = sub %low, 97
    %letter = le %d, 25
    branch %letter, ^host(%n), ^host_dot(%n, %b)
^host_dot(%n:u64, %b:u8):
    %dot = eq %b, 46
    branch %dot, ^host(%n), ^host_dash(%n, %b)
^host_dash(%n:u64, %b:u8):
    %dash = eq %b, 45
    branch %dash, ^host(%n), ^bad()
^host_end(%n:u64):
    %empty = eq %n, 0
    branch %empty, ^bad(), ^port_check(%n)
^port_check(%n:u64):
    %end = eq %n, %len
    branch %end, ^done(%n), ^colon(%n)
^colon(%n:u64):
    %b = call @byte(%data, %n)
    %colon = eq %b, 58
    branch %colon, ^port(%n), ^bad()
^port(%n:u64):
    %next = add %n, 1
    %size = sub %len, %next
    %index:i64 = cast %next
    %p = offset %data, %index
    %s = call @std_text_parse_u64(%p, %size, %port)
    %ok = eq %s, 0
    branch %ok, ^port_range(%n), ^bad()
^port_range(%n:u64):
    %v = load %port
    %valid = le %v, 65535
    branch %valid, ^port_zero(%n, %v), ^bad()
^port_zero(%n:u64, %v:u64):
    %valid = ne %v, 0
    branch %valid, ^done(%n), ^bad()
^done(%n:u64):
